# Tarter Yard Map — variables de entorno
# ------------------------------------------------------------
# Se cargan en Vercel → proyecto yardmap → Settings → Environment Variables.
# Este archivo es solo la lista: NUNCA pongas valores reales aquí ni
# subas un .env al repositorio (el .gitignore ya lo bloquea).
#
# Las marcadas SECRETO van con tipo "Sensitive" en Vercel, para que no
# se puedan leer desde el panel después de guardarlas.

# --- Supabase (obligatorias) --------------------------------
SUPABASE_URL=                 # Supabase → Project Settings → API
SUPABASE_SECRET_KEY=          # SECRETO. Llave del servidor (sb_secret_… o service_role)

# --- Sesión (obligatoria) -----------------------------------
SESSION_SECRET=               # SECRETO. Frase larga inventada, mínimo 32 caracteres

# --- Primer administrador -----------------------------------
# Solo se usan cuando la tabla de usuarios está vacía: el primer login con
# este nombre y este código crea la cuenta de editor.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_CODE=         # SECRETO

# --- Correo (reportes por email, resumen semanal) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                    # SECRETO
SMTP_FROM=
ALERT_SUMMARY_RECIPIENTS=     # direcciones separadas por coma

# --- Tareas programadas e importación -----------------------
CRON_SECRET=                  # SECRETO. Vercel lo manda en cada cron
INVENTORY_IMPORT_SECRET=      # SECRETO. Power Automate lo manda al importar el TGU

# --- Opcionales (valores por defecto entre paréntesis) ------
# RETENTION_RESOLVED_DAYS=30      # días que se guardan los reportes resueltos
# RETENTION_AUDIT_DAYS=21         # días de bitácora
# RETENTION_HISTORY_KEEP=100      # versiones del mapa que se guardan como mínimo
# RETENTION_HISTORY_DAYS=30
# ALERTS_RESOLVED_WINDOW_DAYS=60  # resueltos que la app descarga
